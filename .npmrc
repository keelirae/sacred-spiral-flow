# npm configuration for optimal dependency resolution

# Use the latest npm lockfile format
lockfile-version=3

# Ensure peer dependencies are automatically installed
auto-install-peers=true

# Register with npm public registry
registry=https://registry.npmjs.org/

# Improve download performance
fetch-timeout=60000
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Enable strict SSL in production
strict-ssl=true
